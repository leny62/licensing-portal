{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  },
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --port 4200 --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "lint": "ng lint",
    "e2e": "playwright test",
    "desktop:build": "tsc -p electron/tsconfig.json",
    "desktop:watch": "tsc -p electron/tsconfig.json --watch",
    "desktop:dev": "concurrently -k \"npm run start\" \"npm run desktop:watch\" \"wait-on http://127.0.0.1:4200 && electron dist-electron/main.js\"",
    "desktop:package": "npm run build && npm run desktop:build && electron-builder --config electron/electron-builder.yaml"
  },
  "dependencies": {
    "@angular/animations": "~18.2.13",
    "@angular/cdk": "~18.2.14",
    "@angular/common": "~18.2.13",
    "@angular/compiler": "~18.2.13",
    "@angular/core": "~18.2.13",
    "@angular/forms": "~18.2.13",
    "@angular/material": "~18.2.14",
    "@angular/platform-browser": "~18.2.13",
    "@angular/platform-browser-dynamic": "~18.2.13",
    "@angular/router": "~18.2.13",
    "@angular/service-worker": "~18.2.13",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~18.2.14",
    "@angular-eslint/builder": "~18.4.3",
    "@angular-eslint/eslint-plugin": "~18.4.3",
    "@angular-eslint/eslint-plugin-template": "~18.4.3",
    "@angular-eslint/schematics": "~18.4.3",
    "@angular-eslint/template-parser": "~18.4.3",
    "@angular/cli": "~18.2.14",
    "@angular/compiler-cli": "~18.2.13",
    "@playwright/test": "^1.48.2",
    "@types/jasmine": "~5.1.4",
    "@types/node": "^20.11.30",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "playwright": "^1.48.2",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.5.4",
    "wait-on": "^7.2.0"
  }
}
