NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Primary connection used by the running API (role: licensing_app)
DATABASE_URL=postgresql://licensing:licensing@localhost:5432/licensing_portal?schema=public
# Migration connection (role: licensing_migrate) — defaults to DATABASE_URL if not set
DATABASE_URL_MIGRATION=postgresql://licensing_migrate:migrate@localhost:5432/licensing_portal

CORS_ORIGINS=http://localhost:4200
SWAGGER_ENABLED=true
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=100
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_UPLOAD_PER_MIN=20

JWT_ISSUER=licensing-portal
JWT_AUDIENCE=licensing-portal-api
JWT_KID=key-1
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# Generate with: openssl genrsa 4096 | base64 -w0
JWT_PRIVATE_KEY_BASE64=replace-with-base64-encoded-rsa-private-key
# Generate with: openssl rsa -pubout -in <key> | base64 -w0
JWT_PUBLIC_KEY_BASE64=replace-with-base64-encoded-rsa-public-key

ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

MFA_ISSUER=National Bank of Rwanda Licensing Portal

DOCUMENT_STORAGE_ROOT=./var/documents
DOCUMENT_MAX_BYTES=5242880
# Generate with: openssl rand -base64 32
DOCUMENT_KEK_BASE64=replace-with-32-byte-base64-key

SNAPSHOT_DESTINATION=./var/snapshots

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@licensing.local
