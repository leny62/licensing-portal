model ApplicationAudit {
  id            String            @id @default(uuid()) @db.Uuid
  applicationId String            @map("application_id") @db.Uuid
  actorId       String?           @map("actor_id") @db.Uuid
  action        String
  fromState     ApplicationState? @map("from_state")
  toState       ApplicationState? @map("to_state")
  justification String?
  sourceIp      String?           @map("source_ip")
  correlationId String?           @map("correlation_id") @db.Uuid
  payload       Json              @default("{}")
  previousHash  String?           @map("previous_hash")
  entryHash     String            @unique @map("entry_hash")
  occurredAt    DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(3)
  clockOffsetMs Int               @default(0) @map("clock_offset_ms")
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  actor         User?             @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([applicationId, occurredAt])
  @@index([actorId])
  @@map("application_audit")
}
