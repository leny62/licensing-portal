generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  APPLICANT
  REVIEWER
  APPROVER
  ADMIN
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum DocumentSlot {
  BUSINESS_PLAN
  INCORPORATION_CERTIFICATE
  FINANCIAL_STATEMENTS
  FIT_AND_PROPER_FORM
  OTHER
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique
  passwordHash    String        @map("password_hash")
  role            UserRole
  mfaSecret       String?       @map("mfa_secret")
  mfaEnabled      Boolean       @default(false) @map("mfa_enabled")
  refreshTokens   RefreshToken[]
  applications    Application[] @relation("ApplicantApplications")
  reviewedItems   Application[] @relation("ReviewedApplications")
  approvedItems   Application[] @relation("ApprovedApplications")
  auditLogs        AuditLog[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  familyId       String    @map("family_id") @db.Uuid
  revokedAt      DateTime? @map("revoked_at")
  expiresAt      DateTime  @map("expires_at")
  replacedById   String?   @unique @map("replaced_by_id") @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy     RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id])
  replacementFor RefreshToken? @relation("RefreshTokenRotation")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Application {
  id            String            @id @default(uuid()) @db.Uuid
  applicantId   String            @map("applicant_id") @db.Uuid
  status        ApplicationStatus @default(DRAFT)
  rowVersion    Int               @default(1) @map("row_version")
  submittedAt   DateTime?         @map("submitted_at")
  reviewedById  String?           @map("reviewed_by_id") @db.Uuid
  approvedById  String?           @map("approved_by_id") @db.Uuid
  applicant     User              @relation("ApplicantApplications", fields: [applicantId], references: [id])
  reviewedBy    User?             @relation("ReviewedApplications", fields: [reviewedById], references: [id])
  approvedBy    User?             @relation("ApprovedApplications", fields: [approvedById], references: [id])
  documents     Document[]
  auditLogs     AuditLog[]
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([applicantId])
  @@index([status])
  @@map("applications")
}

model Document {
  id            String       @id @default(uuid()) @db.Uuid
  applicationId String       @map("application_id") @db.Uuid
  slot          DocumentSlot
  version       Int
  storageKey    String       @map("storage_key")
  mimeType      String       @map("mime_type")
  sizeBytes     Int          @map("size_bytes")
  checksum      String
  dekCiphertext Bytes        @map("dek_ciphertext")
  iv            Bytes
  authTag       Bytes        @map("auth_tag")
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now()) @map("created_at")

  @@unique([applicationId, slot, version])
  @@map("documents")
}

model AuditLog {
  id            String       @id @default(uuid()) @db.Uuid
  applicationId String?      @map("application_id") @db.Uuid
  actorId       String?      @map("actor_id") @db.Uuid
  action        String
  payload       Json
  previousHash  String?      @map("previous_hash")
  entryHash     String       @unique @map("entry_hash")
  application   Application? @relation(fields: [applicationId], references: [id])
  actor         User?        @relation(fields: [actorId], references: [id])
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([applicationId])
  @@index([actorId])
  @@map("audit_logs")
}

