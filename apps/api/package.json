{
  "name": "licensing-portal-backend",
  "version": "0.1.0",
  "description": "National Bank of Rwanda — Bank Licensing and Compliance Portal API",
  "private": true,
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "prestart:prod": "npm run db:migrate",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "db:migrate": "prisma migrate deploy --schema prisma/schema",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema",
    "db:generate": "prisma generate --schema prisma/schema",
    "db:validate": "prisma validate --schema prisma/schema",
    "db:seed": "../../node_modules/.bin/ts-node -r tsconfig-paths/register src/seed/seed.ts",
    "test": "jest --config jest.config.ts --passWithNoTests",
    "test:unit": "jest --config jest.unit.config.ts --coverage",
    "test:integration": "jest --config jest.integration.config.ts --runInBand",
    "test:concurrency": "jest --config jest.integration.config.ts --testPathPattern=concurrency --runInBand"
  },
  "dependencies": {
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.1.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-fastify": "^10.3.0",
    "@nestjs/schedule": "^4.0.1",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/throttler": "^5.1.1",
    "@prisma/client": "^5.9.1",
    "argon2": "^0.31.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fastify": "4.28.1",
    "nestjs-pino": "^3.5.0",
    "otplib": "^12.0.1",
    "pino": "^8.19.0",
    "pino-http": "^8.6.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.0",
    "@testcontainers/postgresql": "^10.7.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.16",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-plugin-no-secrets": "^0.8.9",
    "eslint-plugin-security": "^1.7.1",
    "jest": "^29.7.0",
    "pino-pretty": "^11.0.0",
    "prettier": "^3.2.5",
    "prisma": "^5.9.1",
    "testcontainers": "^10.7.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
