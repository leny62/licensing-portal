{
  "name": "licensing-portal",
  "private": true,
  "version": "0.0.0",
  "description": "bank licensing and compliance portal",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm --workspace apps/api run start:dev",
    "api:build": "npm --workspace apps/api run build",
    "api:test": "npm --workspace apps/api test",
    "api:lint": "npm --workspace apps/api run lint",
    "api:migrate": "npm --workspace apps/api run db:migrate",
    "api:seed": "npm --workspace apps/api run db:seed",
    "prisma:migrate": "npm --workspace apps/api run db:migrate",
    "prisma:migrate:dev": "npm --workspace apps/api run db:migrate:dev",
    "prisma:generate": "npm --workspace apps/api run db:generate",
    "prisma:validate": "npm --workspace apps/api run db:validate",
    "prisma:seed": "npm --workspace apps/api run db:seed",
    "web:dev": "npm --workspace apps/web run start",
    "web:build": "npm --workspace apps/web run build",
    "web:test": "npm --workspace apps/web test",
    "web:lint": "npm --workspace apps/web run lint",
    "web:e2e": "npm --workspace apps/web run e2e",
    "desktop:dev": "npm --workspace apps/web run desktop:dev",
    "desktop:package": "npm --workspace apps/web run desktop:package",
    "deploy:contabo": "deployment/scripts/deploy-contabo.sh",
    "backup:prod": "deployment/scripts/backup-postgres.sh",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0 <23.0.0",
    "npm": ">=10.0.0"
  }
}
